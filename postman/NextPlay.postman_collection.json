{
  "info": {
    "name": "NextPlay - Auth (Sprint 1)",
    "description": "Pruebas de los endpoints de Autenticacion (registro y login) del backend NextPlay.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Registro - Exitoso (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Devuelve token', () => pm.expect(body.token).to.be.a('string'));",
                  "pm.test('No devuelve la contrasena', () => pm.expect(body.usuario.contrasena).to.be.undefined);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Luis\",\n  \"apellido\": \"Ortellado\",\n  \"correo\": \"luis.test@example.com\",\n  \"nombreUsuario\": \"luisito\",\n  \"contrasena\": \"Password1\",\n  \"repetirContrasena\": \"Password1\",\n  \"fechaNacimiento\": \"2000-01-01\",\n  \"descripcion\": \"Cuenta de prueba\"\n}"
            },
            "url": {
              "raw": "http://localhost:3000/auth/registro",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["auth", "registro"]
            }
          },
          "response": []
        },
        {
          "name": "Registro - Correo duplicado (409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 409 Conflict', () => pm.response.to.have.status(409));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Otro\",\n  \"apellido\": \"Usuario\",\n  \"correo\": \"luis.test@example.com\",\n  \"nombreUsuario\": \"otroUsuarioDistinto\",\n  \"contrasena\": \"Password1\",\n  \"repetirContrasena\": \"Password1\",\n  \"fechaNacimiento\": \"1999-05-05\"\n}"
            },
            "url": {
              "raw": "http://localhost:3000/auth/registro",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["auth", "registro"]
            }
          },
          "response": []
        },
        {
          "name": "Registro - Contrasena debil (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 400 Bad Request', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Juan\",\n  \"apellido\": \"Perez\",\n  \"correo\": \"juan.debil@example.com\",\n  \"nombreUsuario\": \"juanDebil\",\n  \"contrasena\": \"abc12345\",\n  \"repetirContrasena\": \"abc12345\",\n  \"fechaNacimiento\": \"1999-05-05\"\n}"
            },
            "url": {
              "raw": "http://localhost:3000/auth/registro",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["auth", "registro"]
            }
          },
          "response": []
        },
        {
          "name": "Login - Por correo (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Devuelve token', () => pm.expect(body.token).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuarioOCorreo\": \"luis.test@example.com\",\n  \"contrasena\": \"Password1\"\n}"
            },
            "url": {
              "raw": "http://localhost:3000/auth/login",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["auth", "login"]
            }
          },
          "response": []
        },
        {
          "name": "Login - Por nombre de usuario (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuarioOCorreo\": \"luisito\",\n  \"contrasena\": \"Password1\"\n}"
            },
            "url": {
              "raw": "http://localhost:3000/auth/login",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["auth", "login"]
            }
          },
          "response": []
        },
        {
          "name": "Login - Contrasena incorrecta (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 401 Unauthorized', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuarioOCorreo\": \"luisito\",\n  \"contrasena\": \"ContrasenaMala1\"\n}"
            },
            "url": {
              "raw": "http://localhost:3000/auth/login",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["auth", "login"]
            }
          },
          "response": []
        }
      ]
    }
  ]
}
